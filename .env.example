TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=

# Optional: comma-separated Telegram user ids that can run /audit.
# If omitted, the bot will ask Telegram whether the sender is a group admin.
ADMIN_TELEGRAM_IDS=

SUI_RPC_URL=https://fullnode.mainnet.sui.io:443
NFTREE_PACKAGE_ID=0xf6c6d439ea0da2f3e9ba79e4992a7a4c113215fbf54c442ac9020c315f953705
NFTREE_MODULE_NAME=collection
NFTREE_STRUCT_TYPE=0xf6c6d439ea0da2f3e9ba79e4992a7a4c113215fbf54c442ac9020c315f953705::collection::NFT
NFTREE_NAME_PATTERN=nftree

# HTTP server settings. Keep ENABLE_WEBAPP=false for command-only verification.
ENABLE_WEBAPP=false
WEBAPP_URL=
WEBAPP_PORT=8787
WHALE_CHAT_INVITE_URL=

# Bot polling and re-check cadence.
TELEGRAM_POLL_SECONDS=25
AUDIT_INTERVAL_MINUTES=30

# Local registry path. The folder will be created automatically.
MEMBER_STORE_PATH=data/members.json
